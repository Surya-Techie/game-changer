# Copy to .env in each service folder as needed.

# --- Backend (Node) ---
NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://localhost:27017/qti
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d
AI_SERVICE_URL=http://localhost:8000
SIGNAL_INTERVAL_MS=15000
MOCK_FEED_ENABLED=true

# --- Broker integration ---
# BROKER_MODE=mock keeps all existing behaviour; set to "kite" for live Zerodha
BROKER_MODE=mock
KITE_API_KEY=
KITE_API_SECRET=
# Optional: pre-provisioned access token (otherwise obtained via login flow).
KITE_ACCESS_TOKEN=
KITE_REDIRECT_URI=http://localhost:5173/settings?kite=1

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000/ws

# --- AI service (FastAPI) ---
AI_PORT=8000
